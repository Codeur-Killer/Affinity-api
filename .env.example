# ─── Serveur ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
API_URL=https://votre-api.onrender.com

# ─── Base de données ────────────────────────────────────────────────────────────
#
# CONNECTION POOLING (OBLIGATOIRE pour milliers d'utilisateurs en simultané)
# ────────────────────────────────────────────────────────────────────────────
# Sur Supabase (recommandé) :
#   1. Database > Connection Pooling → activer PgBouncer en mode "Transaction"
#   2. Utiliser l'URL pooler (port 6543) dans DATABASE_URL  ← avec les paramètres ci-dessous
#   3. Garder l'URL directe (port 5432) dans DIRECT_URL     ← uniquement pour les migrations Prisma
#
# Sur Neon : activer "Connection Pooling" dans les settings du projet.
#
# Paramètres obligatoires dans DATABASE_URL avec PgBouncer :
#   ?pgbouncer=true&connection_limit=5&pool_timeout=2
#
# Exemple Supabase + PgBouncer :
DATABASE_URL="postgresql://postgres.[REF]:[PASS]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=2"
DIRECT_URL="postgresql://postgres.[REF]:[PASS]@aws-0-eu-central-1.supabase.com:5432/postgres"

# ─── Sécurité ──────────────────────────────────────────────────────────────────
# Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changez_ceci_par_une_chaine_aleatoire_de_64_caracteres_minimum
JWT_EXPIRES_IN=30d

# ─── Compte de démo Google Play (App access) ───────────────────────────────────
# Ce numéro reçoit toujours ce code OTP fixe, sans envoi de SMS réel — à donner
# tel quel dans le formulaire "App access" de Play Console.
# Doit respecter la validation de l'écran de connexion (préfixe local 70-79 ou 90-99) :
# idéalement un numéro que vous possédez/réservez réellement plutôt qu'un numéro inventé.
TEST_ACCOUNT_PHONE=+22890000000
TEST_ACCOUNT_OTP_CODE=1234

# ─── Firebase Admin SDK ────────────────────────────────────────────────────────
# Firebase Console → Paramètres projet → Comptes de service → Générer une clé privée
FIREBASE_PROJECT_ID=votre-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@votre-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCONTENU_DE_LA_CLÉ\n-----END PRIVATE KEY-----\n"

# ─── FedaPay (paiement Mobile Money Togo / Bénin) ──────────────────────────────
# dashboard.fedapay.com → Paramètres → Clés API
FEDAPAY_SECRET_KEY=sk_live_votre_cle_secrete
FEDAPAY_PUBLIC_KEY=pk_live_votre_cle_publique
# Ajouter ce token à l'URL du webhook dans FedaPay Dashboard : ?token=VOTRE_SECRET
FEDAPAY_WEBHOOK_SECRET=changez_par_une_valeur_aleatoire_secrete_longue

# ─── Plans d'abonnement (prix en FCFA) ─────────────────────────────────────────
PLAN_PRICE_DECOUVERTE=5000
PLAN_PRICE_STANDARD=15000
PLAN_PRICE_PREMIUM=25000
VIP_COMMISSION_FCFA=950

# ─── AfrikSMS (OTP par SMS) ────────────────────────────────────────────────────
# afriksms.com → Mon compte → Intégration API
SMS_API_URL=https://api.afriksms.com/api/web/web_v1/outbounds/send
SMS_API_KEY=votre_sms_api_key
SMS_CLIENT_ID=votre_sms_client_id
SMS_SENDER_ID=Affinity

# ─── Cloudinary (stockage photos profil + KYC) ─────────────────────────────────
# cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_cloudinary_api_key
CLOUDINARY_API_SECRET=votre_cloudinary_api_secret

# ─── Upload local ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
